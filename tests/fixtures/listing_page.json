                <\/div>\n        <\/div>\n    <\/article>\n    <hr class=\"archive__separator\">\n        <article class=\"archive__card\" itemscope itemtype=\"https:\/\/schema.org\/CreativeWork\">\n        <meta itemprop=\"name\" content=\"For Times of Trouble\">\n        <meta itemprop=\"url\" content=\"https:\/\/speeches.byu.edu\/talks\/jeffrey-r-holland\/times-trouble\/\">\n                    <meta itemprop=\"description\" content=\"Troubles we all have, but the \u201cgerm\u201d of discouragement, to use Fitzgerald\u2019s word, is not in the trouble, it is in us.\">\n                            <meta itemprop=\"genre\" content=\"Devotional\">\n                        <meta itemprop=\"about\" content=\"Hope\">\n                        <meta itemprop=\"about\" content=\"Adversity\">\n                        <meta itemprop=\"about\" content=\"Discouragement\">\n                    <a class=\"archive__card-link-overlay\"\n           href=\"https:\/\/speeches.byu.edu\/talks\/jeffrey-r-holland\/times-trouble\/\"\n           aria-label=\"Read speech: For Times of Trouble\"><\/a>\n\n        <div class=\"archive__card-left\">\n            <div class=\"archive__card-image\">\n                <img class=\"archive__card-portrait\" src=\"https:\/\/speeches.byu.edu\/wp-content\/uploads\/2023\/06\/Holland-Jeffrey-R.webp\" alt=\"Elder Jeffrey R. Holland of the Quorum of the Twelve Apostles of The Church of Jesus Christ of Latter-day Saints.\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" width=\"260\" height=\"333\" nopin=\"nopin\" sizes=\"(max-width: 260px) 100vw, 260px\">            <\/div>\n\n            <div class=\"archive__card-content\">\n                                                    <p class=\"archive__card-byline\"><span itemprop=\"author\" itemscope itemtype=\"https:\/\/schema.org\/Person\"><a class=\"archive__card-name\" href=\"https:\/\/speeches.byu.edu\/speakers\/jeffrey-r-holland\/\" rel=\"author\" itemprop=\"url\"><span itemprop=\"name\">Jeffrey R. Holland<\/span><\/a><\/span><\/p>\n                                <p class=\"archive__card-title\">For Times of Trouble<\/p>\n                                    <div class=\"archive__card-meta\">\n                                                    <time class=\"archive__card-date\" itemprop=\"datePublished\" datetime=\"1980-03-18\">18 Mar 1980<\/time>\n                                                                            <span class=\"archive__card-views\">338k views<\/span>\n                                            <\/div>\n                                                    <p class=\"archive__card-excerpt\">Troubles we all have, but the \u201cgerm\u201d of discouragement, to use Fitzgerald\u2019s word, is not in the trouble, it is in us.<\/p>\n                                <div class=\"archive__card-media-links\">\n                                            <a href=\"https:\/\/speeches.byu.edu\/talks\/jeffrey-r-holland\/times-trouble\/?M=V\" class=\"archive__media-link\">\n                            Video                        <\/a>\n                                        <span class=\"archive__media-separator\">|<\/span>\n                                            <a href=\"https:\/\/speeches.byu.edu\/talks\/jeffrey-r-holland\/times-trouble\/?M=A\" class=\"archive__media-link\">\n                            Audio                        <\/a>\n                                        <span class=\"archive__media-separator\">|<\/span>\n                                            <a href=\"https:\/\/speeches.byu.edu\/talks\/jeffrey-r-holland\/times-trouble\/\" class=\"archive__media-link\">\n                            Text                        <\/a>\n                                        <span class=\"archive__media-separator\">|<\/span>\n                                        <div class=\"archive__download\">\n                        <button type=\"button\"\n                                class=\"archive__media-link archive__media-lin