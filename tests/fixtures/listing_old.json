ass=\"archive__media-link archive__media-link--download archive__dropdown-trigger\"\n                                aria-expanded=\"false\"\n                                aria-haspopup=\"true\"\n                                aria-controls=\"archive-dd-3836\">\n                            Download                        <\/button>\n                        <div class=\"archive__dropdown-menu\"\n                             role=\"menu\"\n                             id=\"archive-dd-3836\"\n                             aria-hidden=\"true\">\n                                                            <span class=\"archive__dropdown-item archive__dropdown-item--unavailable\" role=\"menuitem\" aria-disabled=\"true\">MP3<\/span>\n                                                        <span class=\"archive__dropdown-separator\">|<\/span>\n                                                            <a class=\"archive__dropdown-item\" href=\"https:\/\/speeches.byu.edu\/wp-content\/uploads\/pdf\/Busche_FEnzio_1983_05.pdf\" role=\"menuitem\" target=\"_blank\" rel=\"noopener noreferrer\">PDF<\/a>\n                                                    <\/div>\n                    <\/div>\n                                    <\/div>\n                                    <div class=\"archive__card-tags\">\n                                                    <span class=\"archive__tag\">Devotional<\/span>\n                                                                            <span class=\"archive__tag\">Christianity<\/span>\n                                            <\/div>\n                            <\/div>\n        <\/div>\n    <\/article>\n    <hr class=\"archive__separator\">\n        <article class=\"archive__card\" itemscope itemtype=\"https:\/\/schema.org\/CreativeWork\">\n        <meta itemprop=\"name\" content=\"\u201cThe Lord\u2019s Side\u201d\">\n        <meta itemprop=\"url\" content=\"https:\/\/speeches.byu.edu\/talks\/joseph-b-wirthlin\/lords-side\/\">\n                    <meta itemprop=\"description\" content=\"We, too, must choose whether we will serve our Lord and Savior, Jesus Christ, or follow the gods of indulgence and sin that clamor for our attention on every side.\">\n                            <meta itemprop=\"genre\" content=\"Devotional\">\n                        <meta itemprop=\"about\" content=\"Righteousness\">\n                    <a class=\"archive__card-link-overlay\"\n           href=\"https:\/\/speeches.byu.edu\/talks\/joseph-b-wirthlin\/lords-side\/\"\n           aria-label=\"Read speech: \u201cThe Lord\u2019s Side\u201d\"><\/a>\n\n        <div class=\"archive__card-left\">\n            <div class=\"archive__card-image\">\n                <img class=\"archive__card-portrait\" src=\"https:\/\/speeches.byu.edu\/wp-content\/uploads\/jpg\/Wirthlin_Joseph-Web-compressor.jpg\" alt=\"Joseph B. Wirthlin - Mormon Apostle\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" width=\"260\" height=\"333\" nopin=\"nopin\" sizes=\"(max-width: 260px) 100vw, 260px\">            <\/div>\n\n            <div class=\"archive__card-content\">\n                                                    <p class=\"archive__card-byline\"><span itemprop=\"author\" itemscope itemtype=\"https:\/\/schema.org\/Person\"><a class=\"archive__card-name\" href=\"https:\/\/speeches.byu.edu\/speakers\/joseph-b-wirthlin\/\" rel=\"author\" itemprop=\"url\"><span itemprop=\"name\">Joseph B. Wirthlin<\/span><\/a><\/span><\/p>\n                                <p class=\"archive__card-title\">\u201cThe Lord\u2019s Side\u201d<\/p>\n                                    <div class=\"archive__card-meta\">\n                                                    <time class=\"archive__card-date\" itemprop=\"datePublished\" datetime=\"1992-08-02\">2 Aug 1992<\/time>\n                                                                            <span class=\"archive__card-views\">2k views<\/span>\n                                            <\/div>