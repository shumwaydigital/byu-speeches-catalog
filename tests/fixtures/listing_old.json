{"success":true,"data":{"html":"    <article class=\"archive__card\" itemscope itemtype=\"https:\/\/schema.org\/CreativeWork\">\n        <meta itemprop=\"name\" content=\"How to Gain a Testimony\">\n        <meta itemprop=\"url\" content=\"https:\/\/speeches.byu.edu\/talks\/marion-g-romney\/gain-testimony\/\">\n                    <meta itemprop=\"description\" content=\"A testimony of the gospel is essential for your eternal welfare. It is the most important type of knowledge to pursue, and as with all knowledge, requires diligence and humility.\u2026\">\n                            <meta itemprop=\"genre\" content=\"Devotional\">\n                        <meta itemprop=\"about\" content=\"Eternal Life\">\n                        <meta itemprop=\"about\" content=\"Testimony\">\n                    <a class=\"archive__card-link-overlay\"\n           href=\"https:\/\/speeches.byu.edu\/talks\/marion-g-romney\/gain-testimony\/\"\n           aria-label=\"Read speech: How to Gain a Testimony\"><\/a>\n\n        <div class=\"archive__card-left\">\n            <div class=\"archive__card-image\">\n                <img class=\"archive__card-portrait\" src=\"https:\/\/speeches.byu.edu\/wp-content\/uploads\/jpg\/Romney_Marion-Web-compressor.jpg\" alt=\"Marion G. Romney - Mormon Apostle\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" width=\"260\" height=\"333\" nopin=\"nopin\" sizes=\"(max-width: 260px) 100vw, 260px\">            <\/div>\n\n            <div class=\"archive__card-content\">\n                                                    <p class=\"archive__card-byline\"><span itemprop=\"author\" itemscope itemtype=\"https:\/\/schema.org\/Person\"><a class=\"archive__card-name\" href=\"https:\/\/speeches.byu.edu\/speakers\/marion-g-romney\/\" rel=\"author\" itemprop=\"url\"><span itemprop=\"name\">Marion G. Romney<\/span><\/a><\/span><\/p>\n                                <p class=\"archive__card-title\">How to Gain a Testimony<\/p>\n                            