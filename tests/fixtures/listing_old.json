ds\/pdf\/Heise_Barbara_2010_03.pdf\" role=\"menuitem\" target=\"_blank\" rel=\"noopener noreferrer\">PDF<\/a>\n                                                    <\/div>\n                    <\/div>\n                                    <\/div>\n                                    <div class=\"archive__card-tags\">\n                                                    <span class=\"archive__tag\">Devotional<\/span>\n                                                                            <span class=\"archive__tag\">Jesus Christ<\/span>\n                                            <\/div>\n                            <\/div>\n        <\/div>\n    <\/article>\n    <hr class=\"archive__separator\">\n        <article class=\"archive__card\" itemscope itemtype=\"https:\/\/schema.org\/CreativeWork\">\n        <meta itemprop=\"name\" content=\"That You May Not Be Deceived\">\n        <meta itemprop=\"url\" content=\"https:\/\/speeches.byu.edu\/talks\/spencer-w-kimball\/may-deceived\/\">\n                    <meta itemprop=\"description\" content=\"It is easy, among so many different voices in the world, to be deceived. But if we are worthy of the Spirit and true to the Church, we won&#039;t be\u2026\">\n                            <meta itemprop=\"genre\" content=\"Devotional\">\n                        <meta itemprop=\"about\" content=\"The Church of Jesus Christ of Latter-day Saints\">\n                        <meta itemprop=\"about\" content=\"Holy Ghost\">\n                        <meta itemprop=\"about\" content=\"Spirit\">\n                    <a class=\"archive__card-link-overlay\"\n           href=\"https:\/\/speeches.byu.edu\/talks\/spencer-w-kimball\/may-deceived\/\"\n           aria-label=\"Read speech: That You May Not Be Deceived\"><\/a>\n\n        <div class=\"archive__card-left\">\n            <div class=\"archive__card-image\">\n                <img class=\"archive__card-portrait\" src=\"https:\/\/speeches.byu.edu\/wp-content\/uploads\/jpg\/Kimball_Spencer-Web-compressor.jpg\" alt=\"Kimball_Spencer-W\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" width=\"260\" height=\"333\" nopin=\"nopin\" sizes=\"(max-width: 260px) 100vw, 260px\">            <\/div>\n\n            <div class=\"archive__card-content\">\n                                                    <p class=\"archive__card-byline\"><span itemprop=\"author\" itemscope itemtype=\"https:\/\/schema.org\/Person\"><a class=\"archive__card-name\" href=\"https:\/\/speeches.byu.edu\/speakers\/spencer-w-kimball\/\" rel=\"author\" itemprop=\"url\"><span itemprop=\"name\">Spencer W. Kimball<\/span><\/a><\/span><\/p>\n                                <p class=\"archive__card-title\">That You May Not Be Deceived<\/p>\n                                    <div class=\"archive__card-meta\">\n                                                    <time class=\"archive__card-date\" itemprop=\"datePublished\" datetime=\"1959-11-11\">11 Nov 1959<\/time>\n                                                                            <span class=\"archive__card-views\">2k views<\/span>\n                                            <\/div>\n                                                    <p class=\"archive__card-excerpt\">It is easy, among so many different voices in the world, to be deceived. But if we are worthy of the Spirit and true to the Church, we won&#039;t be\u2026<\/p>\n                                <div class=\"archive__card-media-links\">\n                                            <span class=\"archive__media-link archive__media-link--unavailable\">Video<\/span>\n                                        <span class=\"archive__media-separator\">|<\/span>\n                                            <a href=\"https:\/\/speeches.byu.edu\/talks\/spencer-w-kimball\/may-deceived\/?M=A\" class=\"archive__media-link\">\n                            Audio                        <\/a>\n                                        <span class=\"archive__media-separator\">|<\/span>\n                                            <a href=\"https:\/\/speeches.byu.edu\/talks\/spencer-w-kimball\/may-deceived\/\" class=\"archive__media-link\">\n                            Text                        <\/a>\n                                        <span class=\"archive__media-separator\">|<\/span>\n                                        <div class=\"archive__download\">\n                        <button type=\"button\"\n                                class=\"archive__media-link archive__media-link--download archive__dropdown-trigger\"\n                                aria-expanded=\"false\"\n                                aria-haspopup=\"true\"\n                                aria-controls=\"archive-dd-5868\">\n                            Download                        <\/button>\n                        <div class=\"archive__dropdown-menu\"\n                             role=\"menu\"\n                             id=\"archive-dd-5868\"\n                             aria-hidden=\"true\">\n                                                            <a class=\"archive__dropdown-item\" href=\"https:\/\/speeches.byu.edu\/wp-content\/uploads\/mp3\/Kimball_Spencer_1959_11_11.mp3\" role=\"menuitem\" download>MP3<\/a>\n                                                        <span class=\"archive__dropdown-separator\">|<\/span>\n                                                            <span class=\"archive__dropdown-item archive__dropdown-item--unavailable\" role=\"menuitem\" aria-disabled=\"true\">PDF<\/span>\n                                                    <\/div>\n                    <\/div>\n                                    <\/div>\n                                    <div class=\"archive__card-tags\">\n                                                    <span class=\"archive__tag\">Devotional<\/span>\n                                                                            <span class=\"archive__tag\">The Church of Jesus Christ of Latter-day Saints<\/span>\n                                                    <span class=\"archive__tag\">Holy Ghost<\/span>\n                                                    <span class=\"archive__tag\">Spirit<\/span>\n                                            <\/div>\n                            <\/div>\n        <\/div>\n    <\/article>\n    <hr class=\"archive__separator\">\n        <article class=\"archive__card\" itemscope itemtype=\"https:\/\/schema.org\/CreativeWork\">\n        <meta itemprop=\"name\" content=\"Christianity and the Hope of the Future\">\n        <meta itemprop=\"url\" content=\"https:\/\/speeches.byu.edu\/talks\/f-enzio-busche\/christianity-hope-future\/\">\n                    <meta itemprop=\"description\" content=\"Dear President Holland, members of the faculty, and students of this great university of The Church of Jesus Christ of Latter-day Saints, I appreciate very much the invitation to speak\u2026\">\n                            <meta itemprop=\"genre\" content=\"Devotional\">\n                        <meta itemprop=\"about\" content=\"Christianity\">\n                    <a class=\"archive__card-link-overlay\"\n           href=\"https:\/\/speeches.byu.edu\/talks\/f-enzio-busche\/christianity-hope-future\/\"\n           aria-label=\"Read speech: Christianity and the Hope of the Future\"><\/a>\n\n        <div class=\"archive__card-left\">\n            <div class=\"archive__card-image\">\n                <img class=\"archive__card-portrait\" src=\"https:\/\/speeches.byu.edu\/wp-content\/uploads\/jpg\/Busche_Enzio-Web-compressor.jpg\" alt=\"F. Enzio Busche\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\" width=\"261\" height=\"333\" nopin=\"nopin\" sizes=\"(max-width: 261px) 100vw, 261px\">            <\/div>\n\n            <div class=\"archive__card-content\">\n                                                    <p class=\"archive__card-byline\"><span itemprop=\"author\" itemscope itemtype=\"https:\/\/schema.org\/Person\